#!/bin/sh
set -e

. /usr/share/debconf/confmodule

ENV_FILE=/etc/tapir/tapir.env

# Seed the questions with the values currently in the configuration file,
# so that manual edits are shown and preserved.
seed() {
    value="$(sed -n "s/^$2=//p" "$ENV_FILE" | tail -n 1)"
    if [ -n "$value" ]; then
        db_set "tapir/$1" "$value"
    fi
}

if [ -r "$ENV_FILE" ]; then
    seed site_url SITE_URL
    seed database_url DATABASE_CONNECTION
    seed redis_url CELERY_BROKER_URL
    seed keycloak_admin_url KEYCLOAK_ADMIN_SERVER_URL
    seed keycloak_public_url KEYCLOAK_PUBLIC_URL
    # An existing installation keeps its own Keycloak address
    site_origin="$(sed -n "s/^SITE_URL=//p" "$ENV_FILE" | tail -n 1 | sed -E 's|^([a-z]+://[^/]+).*|\1|')"
    keycloak_public_url="$(sed -n "s/^KEYCLOAK_PUBLIC_URL=//p" "$ENV_FILE" | tail -n 1)"
    if [ -n "$keycloak_public_url" ] && [ "${keycloak_public_url%/}" != "$site_origin" ]; then
        db_set tapir/keycloak_proxy false
    fi
    seed keycloak_realm KEYCLOAK_REALM_NAME
    seed keycloak_client_id KEYCLOAK_CLIENT_ID
    seed gunicorn_bind GUNICORN_BIND
    if ! grep -q '^DATABASE_CONNECTION=postgresql://tapir:CHANGE_ME@' "$ENV_FILE"; then
        db_set tapir/database_auto false
    fi
fi

db_input high tapir/site_url || true
db_go || true

db_input high tapir/database_auto || true
db_go || true
db_get tapir/database_auto
if [ "$RET" = false ]; then
    db_input high tapir/database_url || true
fi

db_input high tapir/redis_url || true
db_input high tapir/keycloak_admin_url || true
# Behind the generated nginx site, the public Keycloak URL is the public URL of Tapir.
# Not for a local installation without reverse proxy.
db_get tapir/site_url
case "$RET" in
    *://localhost*|*://127.0.0.1*) local_site=true ;;
    *) local_site=false; db_input high tapir/keycloak_proxy || true ;;
esac
db_go || true
db_get tapir/keycloak_proxy
if [ "$RET" = false ] || [ "$local_site" = true ]; then
    db_input high tapir/keycloak_public_url || true
fi

for question in keycloak_realm keycloak_client_id keycloak_client_secret gunicorn_bind; do
    db_input high "tapir/$question" || true
done
db_input medium tapir/tls_certificate || true
db_input medium tapir/tls_certificate_key || true
db_go || true
