# Settings for the Bareos jobs of tapir-instance (copy to /etc/tapir/bareos.env).
# Every instance gets its own FileSet and Job "tapir-<name>", plus one job "tapir-shared" for the
# Keycloak database, /etc/tapir and the licensed theme fonts. Show them: tapir-instance bareos --all

# Name of the client resource of this machine in the director (default: <short hostname>-fd)
#BAREOS_CLIENT=forgeiec-fd

# Director that backs up this machine: its name in /etc/bareos/bareos-fd.d/director/ (the password
# from there goes into the generated Client resource)
# (default: the only director there that is not a tray monitor, otherwise bareos-dir)
#BAREOS_DIRECTOR=bareos-dir

# Address under which the director reaches this machine (default: hostname -f)
#BAREOS_CLIENT_ADDRESS=forgeiec.io

# Passive client: director and storage daemon connect to this machine, it never connects back -
# needed when the director sits in a home network behind a router (yes/no)
#BAREOS_PASSIVE=yes

# Configuration directory of the file daemon on this machine
#BAREOS_FD_CONFIG=/etc/bareos/bareos-fd.d

# JobDefs the jobs are based on (schedule, pools, storage, messages); DefaultJob comes with Bareos
# "none": the jobs get Type, Level and Messages themselves and need BAREOS_STORAGE
#BAREOS_JOBDEFS=DefaultJob
#BAREOS_MESSAGES=Standard

# Optional overrides of the JobDefs
#BAREOS_SCHEDULE=WeeklyCycle
#BAREOS_POOL=Full

# Own pool for the Tapir jobs, written with the Client (default: yes, named Tapir); "no" uses the
# existing pool BAREOS_POOL, or the pool of the JobDefs when BAREOS_POOL is empty
#BAREOS_POOL_CREATE=yes
#BAREOS_POOL_LABEL=Tapir-
#BAREOS_POOL_VOLUME_BYTES=50 g
#BAREOS_POOL_VOLUMES=100
#BAREOS_POOL_RETENTION=6 months
#BAREOS_STORAGE=File

# Checksum of the FileSets; XXH128 needs Bareos 22 or newer, older ones use MD5
#BAREOS_SIGNATURE=XXH128

# Director on this machine: create, adopt and remove write and delete the jobs there by themselves
#BAREOS_CONFIG_DIR=/etc/bareos/bareos-dir.d

# Command that reads "reload" after a change ("none": reload yourself)
#BAREOS_RELOAD=bconsole
