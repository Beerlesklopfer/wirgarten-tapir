#!/bin/sh
# Runs Django's manage.py as the tapir user. The settings read /etc/tapir/tapir.env
# themselves (via the /opt/tapir/app/.env.local symlink).
set -e
cd /opt/tapir/app
cmd="set -a; . /opt/tapir/version.env; set +a; exec /opt/tapir/venv/bin/python manage.py \"\$@\""
if [ "$(id -u)" = 0 ]; then
    exec setpriv --reuid=tapir --regid=tapir --init-groups --reset-env sh -c "$cmd" tapir-manage "$@"
fi
exec sh -c "$cmd" tapir-manage "$@"
