#!/bin/bash
# Sets up Keycloak for Tapir on this machine and connects Tapir to it. Idempotent.
#
#   tapir-setup-keycloak [--domain tapir.example.org] [--port 8800] [--admin-email you@example.org] [--no-nginx]
#
# - Keycloak runs as podman container "tapir-keycloak" (systemd unit via quadlet, network host),
#   listens on 127.0.0.1:<port>, uses PostgreSQL database "keycloak" on this machine.
# - The realm "tapir" is imported for https://<domain> with a freshly generated client secret.
# - /etc/tapir/tapir.env gets SITE_URL, ALLOWED_HOSTS and the KEYCLOAK_* settings; tapir.target restarts.
# - With --admin-email, a Tapir admin with a Keycloak login is created (password in /root/tapir-initial-admin.txt).
# - nginx: the Keycloak login paths are added to the enabled site of <domain> (backup, nginx -t, reload),
#   otherwise /etc/nginx/sites-available/tapir is written and has to be enabled by hand.
# Secrets live in /etc/tapir/keycloak.env (root only). The Keycloak admin console is not public:
#   ssh -L <port>:127.0.0.1:<port> root@<server>, then http://localhost:<port>/admin (user admin).
set -euo pipefail

KEYCLOAK_IMAGE="${KEYCLOAK_IMAGE:-quay.io/keycloak/keycloak:26.8.0}"
TAPIR_ENV=/etc/tapir/tapir.env
KC_ENV=/etc/tapir/keycloak.env
KC_DATA=/var/lib/tapir-keycloak
QUADLET=/etc/containers/systemd/tapir-keycloak.container
NGINX_SNIPPET=/etc/nginx/snippets/tapir-keycloak.conf
NGINX_ACTIVE=false
REALM=tapir
CLIENT_ID=tapir-backend

DOMAIN=""
PORT=8800
ADMIN_EMAIL=""
NGINX=true
while [ $# -gt 0 ]; do
    case "$1" in
        --domain) DOMAIN="$2"; shift 2 ;;
        --port) PORT="$2"; shift 2 ;;
        --admin-email) ADMIN_EMAIL="$2"; shift 2 ;;
        --no-nginx) NGINX=false; shift ;;
        -h|--help) sed -n '2,16p' "$0"; exit 0 ;;
        *) echo "unknown option $1" >&2; exit 2 ;;
    esac
done

# Rewrites an nginx site (read twice): in every server block that listens on 443 - wherever the
# listen line is, certbot appends it at the end - drop own /realms/ and /resources/ locations,
# include the snippet before "location /" and point "location /" to gunicorn.
NGINX_REWRITE='
    function count(s, c,   t) { t = s; return gsub(c, "", t) }
    NR == FNR {
        if (depth == 0 && $0 ~ /^[[:space:]]*server[[:space:]]*\{/) block++
        if (depth >= 1 && $0 ~ /^[[:space:]]*listen[^;]*443/) https[block] = 1
        depth += count($0, "\\{") - count($0, "\\}")
        next
    }
    {
        opens = count($0, "\\{"); closes = count($0, "\\}")
        if (level == 0 && $0 ~ /^[[:space:]]*server[[:space:]]*\{/) { current++; done = 0 }
        level += opens - closes
    }
    skip { skip_depth += opens - closes; if (skip_depth <= 0) skip = 0; next }
    https[current] && /^[[:space:]]*location[[:space:]]+\/(realms|resources)\/[[:space:]]*\{/ {
        skip_depth = opens - closes; if (skip_depth > 0) skip = 1; next }
    https[current] && /include[[:space:]]+[^;]*tapir-keycloak\.conf/ { next }
    https[current] && !done && /^[[:space:]]*location[[:space:]]+\/[[:space:]]*\{/ {
        match($0, /^[[:space:]]*/); print substr($0, 1, RLENGTH) "include " snippet ";"
        done = 1; in_root = 1 }
    in_root && /proxy_pass[[:space:]]/ { sub(/proxy_pass[[:space:]]+[^;]+;/, "proxy_pass " upstream ";"); in_root = 0 }
    in_root && /\}/ { in_root = 0 }
    { print }
'

log() { printf '\033[1m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[33mWARNING: %s\033[0m\n' "$*" >&2; }
die() { printf '\033[31mERROR: %s\033[0m\n' "$*" >&2; exit 1; }
to_bool() { case "$1" in [Tt]rue|1|yes) echo true ;; *) echo false ;; esac; }
random_string() { tr -dc 'A-Za-z0-9' </dev/urandom | head -c "$1" || true; }
env_value() { sed -n "s/^$2=//p" "$1" 2>/dev/null | tail -n 1; }
set_env() {  # file key value
    escaped="$(printf '%s' "$3" | sed 's/[&|\\]/\\&/g')"
    if grep -q "^#\?$2=" "$1"; then
        sed -i "0,/^#\?$2=.*/s||$2=$escaped|" "$1"
    else
        printf '%s=%s\n' "$2" "$3" >> "$1"
    fi
}

[ "$(id -u)" = 0 ] || die "run as root"
[ -r "$TAPIR_ENV" ] || die "$TAPIR_ENV not found - install the tapir package first"

# Realm template and login theme: next to this script (standalone) or from the package
ASSETS="$(cd "$(dirname "$0")" && pwd)"
[ -r "$ASSETS/tapir-realm.json.in" ] || ASSETS="$ASSETS/keycloak"
[ -r "$ASSETS/tapir-realm.json.in" ] || ASSETS=/usr/share/tapir/keycloak
[ -r "$ASSETS/tapir-realm.json.in" ] || die "realm template tapir-realm.json.in not found"

if [ -z "$DOMAIN" ]; then
    DOMAIN="$(env_value "$TAPIR_ENV" SITE_URL | sed -E 's|^[a-z]+://||; s|[:/].*$||')"
fi
case "$DOMAIN" in
    ""|localhost|127.0.0.1) die "no public domain - call with --domain tapir.example.org" ;;
esac
PUBLIC_URL="https://$DOMAIN"
log "Keycloak for $PUBLIC_URL on 127.0.0.1:$PORT"

# --- packages -----------------------------------------------------------------------------------
missing=""
command -v podman >/dev/null || missing="$missing podman"
command -v psql >/dev/null || missing="$missing postgresql"
command -v curl >/dev/null || missing="$missing curl"
if [ -n "$missing" ] && [ -n "${DPKG_MAINTSCRIPT_PACKAGE:-}" ]; then
    die "missing$missing - install it (apt install$missing) and run tapir-setup-keycloak again"
elif [ -n "$missing" ]; then
    log "Installing$missing"
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $missing
fi
runuser -u postgres -- psql -X -tAc 'SELECT 1' >/dev/null 2>&1 || die "local PostgreSQL is not running"

# --- secrets ------------------------------------------------------------------------------------
if [ ! -e "$KC_ENV" ]; then
    install -m 0600 /dev/null "$KC_ENV"
fi
for key in KC_DB_PASSWORD KC_BOOTSTRAP_ADMIN_PASSWORD TAPIR_CLIENT_SECRET; do
    [ -n "$(env_value "$KC_ENV" $key)" ] || set_env "$KC_ENV" $key "$(random_string 32)"
done
DB_PASSWORD="$(env_value "$KC_ENV" KC_DB_PASSWORD)"
ADMIN_PASSWORD="$(env_value "$KC_ENV" KC_BOOTSTRAP_ADMIN_PASSWORD)"
CLIENT_SECRET="$(env_value "$KC_ENV" TAPIR_CLIENT_SECRET)"
while IFS='=' read -r key value; do
    set_env "$KC_ENV" "$key" "$value"
done <<EOF
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://127.0.0.1:5432/keycloak
KC_DB_USERNAME=keycloak
KC_HOSTNAME=$PUBLIC_URL
KC_HOSTNAME_ADMIN=http://localhost:$PORT
KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true
KC_PROXY_HEADERS=xforwarded
KC_HTTP_ENABLED=true
KC_HTTP_HOST=127.0.0.1
KC_HTTP_PORT=$PORT
KC_BOOTSTRAP_ADMIN_USERNAME=admin
EOF

# --- database -----------------------------------------------------------------------------------
psql_admin() { runuser -u postgres -- psql -X -q -tA "$@"; }
if [ "$(psql_admin -c "SELECT 1 FROM pg_roles WHERE rolname = 'keycloak'")" = 1 ]; then
    psql_admin -c "ALTER ROLE keycloak LOGIN PASSWORD '$DB_PASSWORD'"
else
    log "Creating PostgreSQL role and database keycloak"
    psql_admin -c "CREATE ROLE keycloak LOGIN PASSWORD '$DB_PASSWORD'"
fi
if [ "$(psql_admin -c "SELECT 1 FROM pg_database WHERE datname = 'keycloak'")" != 1 ]; then
    runuser -u postgres -- createdb --owner=keycloak keycloak
fi

# --- realm and theme ----------------------------------------------------------------------------
install -d -m 0755 "$KC_DATA" "$KC_DATA/themes"
install -d -m 0750 "$KC_DATA/import"
sed -e "s|@DOMAIN@|$DOMAIN|g" -e "s|@CLIENT_SECRET@|$CLIENT_SECRET|g" \
    "$ASSETS/tapir-realm.json.in" > "$KC_DATA/import/tapir-realm.json"
chmod 0644 "$KC_DATA/import/tapir-realm.json"  # read by the keycloak user in the container
rm -rf "$KC_DATA/themes/wirgarten"
cp -rL "$ASSETS/themes/wirgarten" "$KC_DATA/themes/"

# --- container ----------------------------------------------------------------------------------
if ss -ltnH "sport = :$PORT" | grep -q . && ! podman container exists tapir-keycloak; then
    die "port $PORT is already in use"
fi
log "Pulling $KEYCLOAK_IMAGE"
podman pull -q "$KEYCLOAK_IMAGE" >/dev/null
install -d /etc/containers/systemd
cat > "$QUADLET" <<EOF
# Written by tapir-setup-keycloak
[Unit]
Description=Keycloak for Tapir
Wants=network-online.target
After=network-online.target postgresql.service

[Container]
ContainerName=tapir-keycloak
Image=$KEYCLOAK_IMAGE
Network=host
EnvironmentFile=$KC_ENV
Volume=$KC_DATA/import:/opt/keycloak/data/import:ro
Volume=$KC_DATA/themes/wirgarten:/opt/keycloak/themes/wirgarten:ro
Exec=start --import-realm

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl restart tapir-keycloak.service
log "Waiting for Keycloak (first start builds and imports, takes a minute)"
for _ in $(seq 1 120); do
    curl -fs -o /dev/null "http://127.0.0.1:$PORT/realms/$REALM" && break
    sleep 3
done
curl -fs -o /dev/null "http://127.0.0.1:$PORT/realms/$REALM" \
    || die "Keycloak does not answer, see: journalctl -u tapir-keycloak"

# --- realm settings, also for an already existing realm ------------------------------------------
kcadm() { podman exec tapir-keycloak /opt/keycloak/bin/kcadm.sh "$@"; }
kcadm config credentials --server "http://127.0.0.1:$PORT" --realm master \
    --user admin --password "$ADMIN_PASSWORD" >/dev/null
kcadm update "realms/$REALM" -s "attributes.frontendUrl=$PUBLIC_URL"
for client in tapir-backend tapir-frontend; do
    id="$(kcadm get clients -r $REALM -q clientId=$client --fields id --format csv --noquotes)"
    kcadm update "clients/$id" -r $REALM -s "rootUrl=$PUBLIC_URL" \
        -s "redirectUris=[\"$PUBLIC_URL/*\"]" -s "webOrigins=[\"$PUBLIC_URL\"]" \
        -s "attributes.\"post.logout.redirect.uris\"=$PUBLIC_URL/*"
    if [ "$client" = "$CLIENT_ID" ]; then
        kcadm update "clients/$id" -r $REALM -s "secret=$CLIENT_SECRET"
    fi
done
# Mails (verify e-mail, reset password) through the same server as Tapir
email_host="$(env_value "$TAPIR_ENV" EMAIL_HOST)"
if [ -n "$email_host" ]; then
    sender="$(env_value "$TAPIR_ENV" EMAIL_HOST_SENDER)"
    smtp_user="$(env_value "$TAPIR_ENV" EMAIL_HOST_USER)"
    kcadm update "realms/$REALM" \
        -s "smtpServer.host=$email_host" \
        -s "smtpServer.port=$(env_value "$TAPIR_ENV" EMAIL_PORT | grep . || echo 587)" \
        -s "smtpServer.from=${sender:-$smtp_user}" \
        -s "smtpServer.fromDisplayName=$(env_value "$TAPIR_ENV" EMAIL_HOST_SENDER_NAME)" \
        -s "smtpServer.starttls=$(to_bool "$(env_value "$TAPIR_ENV" EMAIL_USE_TLS | grep . || echo true)")" \
        -s "smtpServer.ssl=$(to_bool "$(env_value "$TAPIR_ENV" EMAIL_USE_SSL)")" \
        -s "smtpServer.auth=true" -s "smtpServer.user=$smtp_user" \
        -s "smtpServer.password=$(env_value "$TAPIR_ENV" EMAIL_HOST_PASSWORD)"
else
    warn "no EMAIL_HOST in $TAPIR_ENV - Keycloak cannot send verification and password mails yet"
fi

# --- Tapir --------------------------------------------------------------------------------------
log "Connecting Tapir"
set_env "$TAPIR_ENV" SITE_URL "$PUBLIC_URL"
set_env "$TAPIR_ENV" ALLOWED_HOSTS "$DOMAIN"
set_env "$TAPIR_ENV" KEYCLOAK_ADMIN_SERVER_URL "http://127.0.0.1:$PORT"
set_env "$TAPIR_ENV" KEYCLOAK_PUBLIC_URL "$PUBLIC_URL"
set_env "$TAPIR_ENV" KEYCLOAK_REALM_NAME "$REALM"
set_env "$TAPIR_ENV" KEYCLOAK_CLIENT_ID "$CLIENT_ID"
set_env "$TAPIR_ENV" KEYCLOAK_ADMIN_CLIENT_SECRET_KEY "$CLIENT_SECRET"
systemctl restart tapir.target
tapir-manage shell -c "
from tapir.accounts.services.keycloak_user_manager import KeycloakUserManager
KeycloakUserManager.get_keycloak_client({}).get_users({'max': 1})
print('Tapir -> Keycloak admin API: ok')
" 2>&1 | grep -v '^Tapir Version' || die "Tapir cannot reach the Keycloak admin API"

if [ -n "$ADMIN_EMAIL" ]; then
    password="$(random_string 20)"
    # tapir-manage resets the environment, so the values go into the code: both are checked
    printf '%s' "$ADMIN_EMAIL" | grep -qE '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$' || die "invalid admin e-mail $ADMIN_EMAIL"
    result="$(tapir-manage shell -c "
from allauth.socialaccount.models import SocialAccount
from tapir.accounts.models import TapirUser
from tapir.accounts.services.keycloak_user_manager import KeycloakUserManager
email, password = '$ADMIN_EMAIL', '$password'
client = KeycloakUserManager.get_keycloak_client({})
user = TapirUser.objects.filter(email=email).first()
if user is None:
    user = TapirUser.objects.create(email=email, username=email, first_name='Admin', last_name='Tapir', is_staff=True, is_superuser=True)
else:
    user.is_staff = user.is_superuser = True
    user.save()
# A keycloak_id from an earlier Keycloak does not exist in this one
if user.keycloak_id and not client.get_user_id(email):
    SocialAccount.objects.filter(user=user, provider='keycloak').delete()
    user.keycloak_id = None
    user.save()
if user.keycloak_id:
    print('exists')
else:
    KeycloakUserManager.create_keycloak_user_if_necessary(user=user, initial_password=password, cache={})
    print('created')
" 2>&1 | grep -v '^Tapir Version' | tail -n 1 || true)"
    case "$result" in
        created)
            install -m 0600 /dev/null /root/tapir-initial-admin.txt
            printf 'URL: %s\nUser: %s\nPassword: %s\n' "$PUBLIC_URL" "$ADMIN_EMAIL" "$password" > /root/tapir-initial-admin.txt
            log "Admin $ADMIN_EMAIL created, password in /root/tapir-initial-admin.txt" ;;
        exists) log "Admin $ADMIN_EMAIL already has a Keycloak login" ;;
        *) die "creating the admin failed: $result" ;;
    esac
fi

# --- nginx --------------------------------------------------------------------------------------
gunicorn="$(env_value "$TAPIR_ENV" GUNICORN_BIND)"
gunicorn="${gunicorn:-127.0.0.1:8000}"
if [ "$NGINX" = true ] && [ -d /etc/nginx ]; then
    install -d /etc/nginx/snippets
    cat > "$NGINX_SNIPPET" <<EOF
# Written by tapir-setup-keycloak: Keycloak login/OIDC paths for Tapir. The admin console stays internal.
location /realms/ {
    proxy_pass http://127.0.0.1:$PORT;
    proxy_set_header Host \$host;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto \$scheme;
    proxy_set_header X-Forwarded-Host \$host;
    proxy_set_header X-Forwarded-Port \$server_port;
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
}
location /resources/ {
    proxy_pass http://127.0.0.1:$PORT;
    proxy_set_header Host \$host;
    proxy_set_header X-Forwarded-Proto \$scheme;
}
EOF
    site="$(grep -lE "server_name[^;]*[[:space:]]$DOMAIN([[:space:];]|$)" /etc/nginx/sites-enabled/* 2>/dev/null | head -n 1 || true)"
    if [ -n "$site" ]; then
        site="$(readlink -f "$site")"
        backup="/root/$(basename "$site").$(date +%Y%m%d%H%M%S).bak"
        cp -a "$site" "$backup"
        # In the HTTPS server block: drop own /realms/ and /resources/ locations, include the snippet
        # before "location /" and point "location /" to gunicorn.
        awk -v snippet="$NGINX_SNIPPET" -v upstream="http://$gunicorn" "$NGINX_REWRITE" "$backup" "$backup" > "$site"
        if ! grep -q "tapir-keycloak.conf" "$site"; then
            cp -a "$backup" "$site"
            warn "no HTTPS server block with \"location /\" in $site - add: include $NGINX_SNIPPET;"
        elif nginx -t 2>/dev/null; then
            systemctl reload nginx
            NGINX_ACTIVE=true
            log "nginx: $site updated (backup $backup) and reloaded"
        else
            cp -a "$backup" "$site"
            nginx -t || true
            warn "nginx -t failed - $site restored, add by hand: include $NGINX_SNIPPET;"
        fi
    elif [ -n "${DPKG_MAINTSCRIPT_PACKAGE:-}" ] && [ -d /etc/nginx/sites-available ]; then
        log "nginx: the package writes /etc/nginx/sites-available/tapir - enable it by hand"
    elif [ -r /usr/share/tapir/nginx-site.conf.in ] && [ -d /etc/nginx/sites-available ]; then
        warn "no enabled nginx site for $DOMAIN - run 'dpkg-reconfigure tapir' to write /etc/nginx/sites-available/tapir and enable it by hand"
    else
        warn "no enabled nginx site for $DOMAIN - add 'include $NGINX_SNIPPET;' to its HTTPS server block"
    fi
fi

# --- checks -------------------------------------------------------------------------------------
log "Checks"
check() {  # description, command...
    if "${@:2}" >/dev/null 2>&1; then echo "  ok    $1"; else echo "  FAIL  $1"; failed=1; fi
}
failed=0
issuer="$(curl -fs "http://127.0.0.1:$PORT/realms/$REALM/.well-known/openid-configuration" | sed -n 's/.*"issuer":"\([^"]*\)".*/\1/p')"
check "Keycloak issuer is $PUBLIC_URL/realms/$REALM" test "$issuer" = "$PUBLIC_URL/realms/$REALM"
check "Tapir answers on $gunicorn" curl -fs -o /dev/null --max-time 20 -H "Host: $DOMAIN" -H "X-Forwarded-Proto: https" "http://$gunicorn/"
if [ "$NGINX_ACTIVE" = true ]; then
    check "$PUBLIC_URL/realms/$REALM through nginx" \
        curl -fsk -o /dev/null --max-time 20 --resolve "$DOMAIN:443:127.0.0.1" "$PUBLIC_URL/realms/$REALM"
    check "$PUBLIC_URL/ through nginx" \
        curl -fsk -o /dev/null --max-time 20 --resolve "$DOMAIN:443:127.0.0.1" "$PUBLIC_URL/"
fi
[ "$failed" = 0 ] && log "Done: $PUBLIC_URL" || die "some checks failed"
